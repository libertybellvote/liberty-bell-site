{
  "version": "3.0",
  "minimumCurrentFactors": 6,
  "minimumSourceFamilies": 3,
  "maximumAgeHours": 168,
  "robustness": {
    "pollingSourcesForFullWeight": 3,
    "marketPlatformsForFullWeight": 2,
    "singlePollScoreCap": 0.55,
    "singlePlatformMarketScoreCap": 0.35,
    "maximumFactorScore": 0.75,
    "maximumMovementPerRun": 2,
    "minimumIndependentSignalsForPartyChange": 3,
    "independentSignalsForShockOverride": 5
  },
  "pollQuality": {
    "minimumProvisionalMultiplier": 0.5,
    "dimensions": {
      "historicalAccuracy": 25,
      "methodologyTransparency": 20,
      "sampleDesign": 15,
      "questionTransparency": 10,
      "sponsorTransparency": 15,
      "fundingIndependence": 15
    },
    "unknownInformationReceivesCredit": false,
    "partisanFundingRequiresDisclosure": true,
    "outliersRequireIndependentConfirmation": true
  },
  "issueIndex": {
    "weights": {
      "voterPriority": 30,
      "breadth": 25,
      "intensity": 15,
      "momentum": 15,
      "modelRelevance": 15
    },
    "minimumSourceFamilies": 2,
    "publishedIssueCount": 10,
    "publishCadenceDays": 7,
    "maximumMovementPerWeek": 3,
    "rules": {
      "singlePollCannotSetRank": true,
      "attentionIsNotImportance": true,
      "feedsExistingSignalsRatherThanAddingTenthSignal": true,
      "namedPeopleRequireDocumentedPoliticalActivity": true,
      "sentimentIsLabeledSeparatelyFromPolicy": true
    }
  },
  "editorial": {
    "voice": ["conversational", "politically literate", "skeptical of conventional wisdom", "clear about uncertainty", "willing to make a call"],
    "avoid": ["market movement presented as the whole story", "generic horse-race filler", "false certainty", "inside-baseball methodology copy on the homepage"],
    "headlineRefresh": {
      "minimumBellMovement": 1,
      "minimumIndependentSignals": 2,
      "refreshOnPartyCallChange": true,
      "refreshOnNomineePickChange": true,
      "refreshOnBreakoutChange": true
    }
  },
  "factors": {
    "polling": { "weight": 18, "label": "Polling", "inputs": ["National and state polling averages", "Presidential job approval", "Issue approval"] },
    "bettingMarkets": { "weight": 12, "label": "Betting market odds" },
    "campaignFundamentals": { "weight": 12, "label": "Campaign fundamentals", "inputs": ["Fundraising and organization", "Endorsements", "Primary schedule and early-state path"] },
    "candidateQuality": { "weight": 10, "label": "Candidate quality" },
    "coalitionStrength": { "weight": 12, "label": "Coalition strength", "inputs": ["Base intensity and durability", "Ideological fit in the primary", "Broad appeal and general-election reach", "Head-to-head performance when reliable tests exist"] },
    "socialSentiment": { "weight": 6, "label": "Social sentiment" },
    "momentum": { "weight": 10, "label": "Momentum" },
    "economicBackdrop": { "weight": 14, "label": "Economic backdrop", "inputs": ["Inflation", "Unemployment", "Real income and consumer pressure", "Presidential approval response to economic conditions"] },
    "fragility": { "weight": 6, "label": "Fragility and insurgency", "inputs": ["Single point of failure", "Institutional or outsider position", "Primary path resilience"] }
  },
  "rules": {
    "missingEvidence": "missing",
    "marketsAreOneFactor": true,
    "attentionIsNotSupport": true,
    "freezeBelowCoverageThreshold": true,
    "platformsMustRemainSeparate": true,
    "singleSourceCannotMakeCall": true,
    "callChangesRequireIndependentAgreement": true,
    "suddenMovementIsRateLimited": true,
    "pollQualityAdjustsInfluence": true,
    "primaryPathIsCandidateSubscore": true,
    "coalitionBreadthBalancesBaseIntensity": true,
    "cookRatingsAreContextNotVerdict": true
  }
}
